{
  "name": "collectai-demo",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["python_workers"],
  "durable_objects": {
    "bindings": [{ "name": "DEMO", "class_name": "CollectAIDemo" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CollectAIDemo"] }],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
